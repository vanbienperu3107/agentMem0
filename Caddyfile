claude.hangocthanh.io.vn {
    encode gzip

    # mem0 vector layer — Caddy verifies MCP_BEARER_TOKEN, swaps for real Qdrant key
    handle /qdrant/* {
        @authorized header api-key "{env.MCP_BEARER_TOKEN}"
        handle @authorized {
            uri strip_prefix /qdrant
            reverse_proxy qdrant:6333 {
                header_up api-key {env.QDRANT_API_KEY}
            }
        }
        respond "Unauthorized" 401
    }

    # REST API — used by archive-upload.py and ChatGPT Custom GPT Actions
    # FastAPI handles auth via Authorization header
    handle /archive/* {
        uri strip_prefix /archive
        reverse_proxy archive-api:8001
    }

    # Memory REST API — ChatGPT Custom GPT (mem0 wrapper)
    handle /memory/* {
        uri strip_prefix /memory
        reverse_proxy memory-rest-api:8002
    }

    # MCP HTTP server — Claude App + ChatGPT App (OAuth 2.1 + DCR).
    # No strip_prefix: internal routes are /mcp/.well-known/*, /mcp/register, etc.
    handle /mcp* {
        reverse_proxy mcp-http-server:8000 {
            flush_interval -1
        }
    }

    handle /health {
        respond "ok" 200
    }

    handle {
        respond "Not Found" 404
    }

    log {
        output file /data/access.log
        format json
    }
}

# Separate service on the same host (not part of the memory stack) — VPN relay.
vpn6.hangocthanh.io.vn {
    reverse_proxy relay-vpn6:8080
}
